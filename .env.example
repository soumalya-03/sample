ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.xlsx,.pptx,.html,.json
DEFAULT_PROVIDER=ollama
CHAT_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Optional cloud provider
OPENAI_API_KEY=
